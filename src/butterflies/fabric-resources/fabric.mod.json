{
  "schemaVersion": 1,
  "id": "forestrybutterflies",
  "version": "${version}",
  "name": "Forestry CE - Refabricated: Butterflies",
  "description": "Optional butterflies, breeding and pollination module for Forestry CE - Refabricated on Fabric 26.2.",
  "environment": "*",
  "mixins": [
    "forestrybutterflies.mixins.json"
  ],
  "authors": [
    "054545641"
  ],
  "contributors": [
    "thedarkcolour",
    "Forestry CE Team",
    "SirSengir",
    "Forestry Team"
  ],
  "contact": {
    "homepage": "https://github.com/054545641/ForestryCE-Refabricated",
    "sources": "https://github.com/054545641/ForestryCE-Refabricated",
    "issues": "https://github.com/054545641/ForestryCE-Refabricated/issues"
  },
  "license": "LGPL-3.0-only",
  "entrypoints": {
    "jei_mod_plugin": ["forestry.lepidopterology.compat.LepidopterologyJeiPlugin"],
    "forestry:client": ["forestry.lepidopterology.client.plugin.LepidopterologyClientRegistration"],
    "forestry:module": [
      "forestry.lepidopterology.ButterfliesFabricModule"
    ],
    "client": [
      "forestry.lepidopterology.client.ButterfliesFabricClient"
    ]
