{
  "schemaVersion": 1,
  "id": "forestry",
  "version": "${version}",
  "name": "Forestry CE - Refabricated",
  "description": "Unofficial Fabric 26.2 port of Forestry: Community Edition. Native gameplay, rendering, world generation and optional JEI/Jade adapters.",
  "environment": "*",
  "accessWidener": "forestry.accesswidener",
  "mixins": [
    "forestry.mixins.json"
  ],
  "authors": [
    "054545641"
  ],
  "contributors": [
    "thedarkcolour",
    "Forestry CE Team",
    "SirSengir",
    "Forestry Team"
  ],
  "contact": {
    "homepage": "https://github.com/054545641/ForestryCE-Refabricated",
    "sources": "https://github.com/054545641/ForestryCE-Refabricated",
    "issues": "https://github.com/054545641/ForestryCE-Refabricated/issues"
  },
  "license": "LGPL-3.0-only",
  "entrypoints": {
    "jade": ["forestry.core.platform.compat.jade.ForestryJadePlugin"],
    "jei_mod_plugin": ["forestry.apiculture.compat.ApicultureJeiPlugin","forestry.arboriculture.compat.ArboricultureJeiPlugin","forestry.core.content.backpacks.compat.StorageJeiPlugin","forestry.core.content.machines.recipes.jei.FactoryJeiPlugin","forestry.core.content.worktable.compat.WorktableJeiPlugin","forestry.core.platform.client.compat.CoreJeiPlugin"],
    "forestry:module": [
      "forestry.core.features.CoreFabricModule"
    ],
    "main": [
      "forestry.Forestry"
    ],
    "client": [
      "forestry.core.platform.client.ForestryFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.2",
    "java": ">=25",
    "fabric-api": ">=${fabricApiMinVersion}",
    "team_reborn_energy": "^5.0.0"
  }
}
